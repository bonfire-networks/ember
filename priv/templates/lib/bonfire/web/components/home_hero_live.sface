<div class={"px-5 pb-6 sm:px-6 sm:pb-7", "pt-6": is_nil(icon()) or is_nil(banner_image())}>
  {#case icon()}
    {#match nil}
    {#match icon}
      {!-- decorative: the name right below says the same; overlaps the banner when there is one, ringed in the card colour so it sits on it --}
      <div class={"relative w-max", "-mt-10 sm:-mt-11": !is_nil(banner_image())}>
        <Bonfire.UI.Common.NextGenImageLive
          src={icon}
          alt=""
          class="size-16 rounded-box bg-base-100 object-cover ring-4 ring-base-100 sm:size-18"
          loading="eager"
        />
      </div>
  {/case}

  <h1
    id="guest-hero-name"
    class={
      "text-balance text-[1.75rem] font-semibold leading-[1.15] tracking-[-0.02em] text-base-content wrap-anywhere sm:text-[2rem] theme-light:font-semibold",
      "mt-4": !is_nil(icon())
    }
  >{instance_name()}</h1>

  <div
    id="about-tagline"
    class="mt-2 max-w-2xl text-balance text-[1.0625rem] leading-snug text-base-content wrap-anywhere *:m-0"
  >{rich(
      Config.get(
        [:ui, :theme, :instance_tagline],
        "Welcome to #{Bonfire.Application.name_and_flavour()}"
      )
    )}</div>

  {#case Config.get([:ui, :theme, :instance_welcome, :description], "")}
    {#match description when description in [nil, ""]}
    {#match description}
      <div
        id="about-description"
        class="mt-3 prose max-w-none text-[0.9375rem] leading-relaxed text-muted wrap-anywhere prose-headings:text-base-content prose-a:text-base-content prose-strong:text-base-content *:max-w-2xl *:first:mt-0 *:last:mb-0"
      >{templated_or_remote_markdown(description)}</div>
  {/case}

  {!-- the page's one primary action, where the reader ends up after the introduction (the masthead keeps the same actions for later) --}
  <div class="mt-6 flex flex-wrap items-center gap-3">
    {#if !Bonfire.Me.Accounts.instance_is_invite_only?()}
      <LinkLive to={path(:signup)} class="btn btn-primary px-5" opts={[id: "hero-signup"]}>{l("Join the community")}</LinkLive>
      <LinkLive to={path(:login, :index)} class="btn btn-ghost px-4" opts={[id: "hero-login"]}>{l("Log in")}</LinkLive>
    {#else}
      <LinkLive
        :if={invite_contact?()}
        to={path(:signup)}
        class="btn btn-primary px-5"
        opts={[id: "about-request-invite"]}
      >{l("Request an invite")}</LinkLive>
      <LinkLive
        to={path(:login, :index)}
        class={if invite_contact?(), do: "btn btn-ghost px-4", else: "btn btn-primary px-5"}
        opts={[id: "hero-login"]}
      >{l("Sign in")}</LinkLive>
    {/if}
  </div>

  {!-- who runs the place and what a guest can do, as one quiet meta line --}
  <div id="about-guest-info" class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm leading-relaxed text-muted">
    {#if @admins != []}
      {#case split_admins(@admins)}
        {#match {named, rest}}
          <span id="community-admins" class="inline-flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
            <span class="flex shrink-0 -space-x-2" aria-hidden="true">
              {#for admin <- Enum.take(@admins, 3)}
                <Bonfire.UI.Common.AvatarLive
                  wrapper_class="avatar size-6 shrink-0 rounded-full ring-2 ring-base-100"
                  class="size-6 rounded-full"
                  is_remote={false}
                  bg_class="rounded-full"
                  src={Media.avatar_url(admin)}
                  user_id={id(admin)}
                  title=""
                />
              {/for}
              <span
                :if={length(@admins) > 3}
                class="relative grid size-6 shrink-0 place-items-center rounded-full bg-fill text-[0.625rem] font-semibold tabular-nums text-base-content ring-2 ring-base-100"
              >+{length(@admins) - 3}</span>
            </span>
            <span>
              {l("Run by")}
              {#for {admin, index} <- Enum.with_index(named)}{admin_separator(index, length(named), rest != [])}<LinkLive to={path(admin)} class="font-medium text-base-content underline-offset-3 hover:underline" opts={admin_opts(admin)}>{admin_name(admin)}</LinkLive>{/for}
              {!-- the rest expand in place (native `details`, so it also works on the static pages guests get) --}
              <details :if={rest != []} id="community-admins-more" class="group/more inline">
                <summary class="inline cursor-pointer list-none font-medium text-base-content underline underline-offset-3 group-open/more:hidden [&::-webkit-details-marker]:hidden">{l("and %{count} others", count: length(rest))}</summary>
                <span>{#for {admin, index} <- Enum.with_index(rest)}{if index == 0, do: ", ", else: admin_separator(index, length(rest), false)}<LinkLive to={path(admin)} class="font-medium text-base-content underline-offset-3 hover:underline" opts={admin_opts(admin)}>{admin_name(admin)}</LinkLive>{/for}</span>
              </details>
            </span>
          </span>
          <span aria-hidden="true">·</span>
      {/case}
    {/if}
    <span>{l("You can read public conversations without an account.")}</span>
    <span :if={Bonfire.Me.Accounts.instance_is_invite_only?()} data-role="signup-closed-note">{l("New accounts are by invitation only.")}</span>
  </div>

  {#case community_links()}
    {#match []}
    {#match links}
      <ul id="community-links" class="mt-6 flex flex-col gap-2" aria-label={l("Community links")}>
        {#for {{name, url}, index} <- Enum.with_index(links)}
          <li>
            <a
              id={"community-link-#{index}"}
              href={url}
              target="_blank"
              rel="noopener"
              title={link_host(url)}
              class="group flex min-h-12 items-center justify-between gap-3 rounded-box border-hair border-divider px-4 text-sm font-medium text-base-content hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              <span class="min-w-0 truncate">{name}</span>
              <#Icon iconify="ph:arrow-up-right" class="size-4 shrink-0 text-muted group-hover:text-base-content" aria-hidden="true" />
            </a>
          </li>
        {/for}
      </ul>
  {/case}
</div>
