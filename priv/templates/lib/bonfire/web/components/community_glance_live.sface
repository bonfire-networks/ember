<section
  id="community-glance"
  class={
    @class,
    "grid grid-cols-1 rounded-box border border-base-content/15",
    "sm:grid-cols-2 sm:divide-x sm:divide-y-0": @admins != []
  }
  aria-label={l("At a glance")}
>
  <div :if={@admins != []} class="min-w-0 p-5">
    <h2 id="community-admins-title" class="type-overline text-muted">{l("Administered by")}</h2>
    <ul id="community-admins" class="mt-3 flex flex-col gap-3" aria-labelledby="community-admins-title">
      {#for admin <- @admins}
        <li class="min-w-0">
          <LinkLive
            to={path(admin)}
            class="group flex min-w-0 items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-2"
            opts={[
              id: "about-admin-#{id(admin)}",
              "data-role": "admin-link",
              title: "@" <> e(admin, :character, :username, "")
            ]}
          >
            <Bonfire.UI.Common.AvatarLive
              wrapper_class="avatar size-11 shrink-0"
              class="size-11 rounded-full"
              is_remote={false}
              bg_class="rounded-full"
              src={Media.avatar_url(admin)}
              user_id={id(admin)}
              title=""
            />
            <span class="flex min-w-0 flex-col leading-tight">
              <strong class="truncate text-base font-medium underline-offset-3 group-hover:underline">{e(admin, :profile, :name, nil) || e(admin, :character, :username, nil)}</strong>
              <span :if={e(admin, :character, :username, nil)} class="mt-0.5 truncate text-sm text-muted">@{e(admin, :character, :username, nil)}</span>
            </span>
          </LinkLive>
        </li>
      {/for}
    </ul>
  </div>

  <div class="min-w-0 p-5">
    <h2 id="about-meta-title" class="type-overline text-muted">{l("At a glance")}</h2>
    <ul id="about-meta" class="mt-3 list-disc space-y-2 pl-[1.1em] text-base leading-snug marker:text-base-content/40" aria-labelledby="about-meta-title">
      {#for text <- Bonfire.UI.Me.SettingsViewsLive.InstanceSummaryLive.meta_facts(
          Bonfire.UI.Me.SettingsViewsLive.InstanceSummaryLive.federation_mode(),
          Bonfire.UI.Me.SettingsViewsLive.InstanceSummaryLive.indexable?()
        )}
        <li>{text}</li>
      {/for}
      <li :if={@is_guest?} id="about-guest-info">{l("Public posts readable without an account")}</li>
      <li :if={@is_guest? and Bonfire.Me.Accounts.instance_is_invite_only?()} data-role="signup-closed-note">{l("New accounts by invitation only")}</li>
    </ul>
  </div>
</section>
