{#case community_links()}
  {#match []}
  {#match links}
    <ul id="community-links" class={"flex flex-col gap-2", @class} aria-label={l("Community links")}>
      {#for {{name, url}, index} <- Enum.with_index(links)}
        <li>
          <a
            id={"community-link-#{index}"}
            href={url}
            target="_blank"
            rel="noopener"
            title={link_host(url)}
            class="group flex min-h-12 items-center justify-between gap-3 rounded-box border border-base-content/15 px-4 text-sm font-medium text-base-content hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <span class="min-w-0 truncate">{name}</span>
            <#Icon iconify="ph:arrow-up-right" class="size-4 shrink-0 text-muted group-hover:text-base-content" aria-hidden="true" />
          </a>
        </li>
      {/for}
    </ul>
{/case}
