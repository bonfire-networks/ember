<section
  :if={@admins != []}
  class={@class}
  id="community-admins"
  aria-labelledby="community-admins-title"
>
  <div class="mb-4">
    <h2 id="community-admins-title" class="text-lg font-semibold leading-snug tracking-[-0.01em] theme-light:text-lg theme-light:font-semibold">{l("Admins")}</h2>
    <p class="mt-1 text-sm text-muted">{l("People who help care for this space")}</p>
  </div>
  <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    {#for admin <- @admins}
      <li class="min-w-0">
        <LinkLive
          to={path(admin)}
          class="group flex h-full min-w-0 items-center gap-3 rounded-box border-hair border-divider p-4 hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2"
          opts={[id: "about-admin-#{id(admin)}", "data-role": "admin-link"]}
        >
          <Bonfire.UI.Common.AvatarLive
            wrapper_class="avatar size-9 shrink-0"
            class="size-9 rounded-full"
            is_remote={false}
            bg_class="rounded-full"
            src={Media.avatar_url(admin)}
            user_id={id(admin)}
            title=""
          />
          <span class="min-w-0">
            <strong class="block text-sm font-semibold wrap-anywhere underline-offset-3 group-hover:underline">{e(admin, :profile, :name, nil) || e(admin, :character, :username, nil)}</strong>
            <small
              :if={e(admin, :character, :username, nil)}
              class="mt-0.5 block text-xs text-muted wrap-anywhere"
            >{"@" <> e(admin, :character, :username, "")}</small>
          </span>
          <#Icon iconify="ph:caret-right" class="ml-auto size-4 shrink-0 text-muted group-hover:text-base-content" aria-hidden="true" />
        </LinkLive>
      </li>
    {/for}
  </ul>
</section>
