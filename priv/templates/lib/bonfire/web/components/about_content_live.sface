<article
  id="about-page"
  aria-labelledby="about-title"
  class={
    "w-full",
    "board-sheet max-w-180 max-md:-mx-3 max-md:w-auto md:mx-auto": @sheet,
    "mx-auto max-w-172 px-5 pb-14 pt-6 sm:px-6": !@sheet
  }
>
  {#case Bonfire.UI.Common.GuestBoardLive.banner_image()}
    {#match nil}
    {#match banner}
      <div
        data-role="about-banner"
        class={"aspect-[3/1] bg-fill bg-cover bg-center sm:aspect-[4/1]", "rounded-box": !@sheet}
        aria-hidden="true"
        style={Bonfire.UI.Common.NextGenImageLive.background_image_set(banner)}
      />
  {/case}

  <div class={"pt-6", "px-4 pb-10 sm:px-10 sm:pb-12": @sheet}>
  <Bonfire.Web.Components.AboutIntroLive is_guest?={@is_guest?} />

  {!-- negative margins matching the padding, so each row's hairline reaches the sheet's edges --}
  <div class="mt-8">
    <Bonfire.Web.Components.CommunityAdminsLive admins={@admins} class={if(@sheet, do: "-mx-4 px-4 sm:-mx-10 sm:px-10", else: "-mx-5 px-5 sm:-mx-6 sm:px-6")} />
    <Bonfire.Web.Components.CommunityGlanceLive is_guest?={@is_guest?} class={if(@sheet, do: "-mx-4 px-4 sm:-mx-10 sm:px-10", else: "-mx-5 px-5 sm:-mx-6 sm:px-6")} />
  </div>

  <div
    :if={@has_rules?}
    class={"border-t border-base-content/15 py-6", "-mx-4 px-4 sm:-mx-10 sm:px-10": @sheet, "-mx-5 px-5 sm:-mx-6 sm:px-6": !@sheet}
  >
    <StatelessComponent
      module={maybe_component(Bonfire.CommunityRules.Web.InstanceRulesSummaryLive, @__context__)}
      sections={@rules_sections}
    />
  </div>

  <section
    :if={Config.get([Bonfire.Web.Views.AboutLive, :include, :preferences], true)}
    class={"border-t border-base-content/15 pt-6", "-mx-4 px-4 sm:-mx-10 sm:px-10": @sheet, "-mx-5 px-5 sm:-mx-6 sm:px-6": !@sheet}
    id="community-defaults"
  >
    <StatelessComponent
      module={maybe_component(Bonfire.UI.Me.SettingsViewsLive.InstanceSummaryLive, @__context__)}
    />
  </section>
  </div>
</article>
