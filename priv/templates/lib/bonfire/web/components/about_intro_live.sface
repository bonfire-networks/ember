<header>
  <h1
    id="about-title"
    class="type-page-title"
  >{Bonfire.UI.Common.GuestBoardLive.instance_name()}</h1>
  <div
    id="about-tagline"
    class="mt-1.5 text-balance text-lg leading-snug text-muted wrap-anywhere *:m-0"
  >{rich(
      Config.get(
        [:ui, :theme, :instance_tagline],
        "Welcome to #{Bonfire.Application.name_and_flavour()}"
      )
    )}</div>


  {#case Config.get([:ui, :theme, :instance_welcome, :description], "")}
    {#match description when description in [nil, ""]}
    {#match description}
      <div
        id="about-description"
        class="mt-5 prose max-w-none text-prose leading-[1.6] text-base-content wrap-anywhere prose-p:my-[1.1em] prose-headings:text-base-content prose-h2:text-xl prose-h2:font-bold prose-a:text-base-content prose-a:decoration-1 prose-a:underline-offset-3 prose-strong:text-base-content *:first:mt-0 *:last:mb-0"
      >{templated_or_remote_markdown(description)}</div>
  {/case}

  {!-- a page may pass its own actions; otherwise invite-only instances offer an invite request --}
  {#if slot_assigned?(:default)}
    <#slot />
  {#else}
    <LinkLive
      :if={@is_guest? and Bonfire.Me.Accounts.instance_is_invite_only?() and
        Bonfire.Web.Components.HomeHeroLive.invite_contact?()}
      to={path(:signup)}
      class="btn btn-primary mt-5 gap-2 rounded-full px-5 text-sm font-medium"
      opts={[id: "about-request-invite"]}
    >
      {l("Request an invite")}
      <#Icon iconify="ph:arrow-right" class="size-4" aria-hidden="true" />
    </LinkLive>
  {/if}
</header>
