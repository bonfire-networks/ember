{!-- the community introduction shared by the guest Home and the About page: tagline (the page heading), description, then the guest note as a quieter meta line --}
<header class="px-5 pb-6 pt-6 sm:px-6">
  <h1
    id="about-tagline"
    class="max-w-xl text-balance text-[1.75rem] font-semibold leading-[1.15] tracking-[-0.02em] text-base-content wrap-anywhere sm:text-[2rem] *:m-0 theme-light:font-semibold theme-light:text-base-content"
  >{rich(
      Config.get(
        [:ui, :theme, :instance_tagline],
        "Welcome to #{Bonfire.Application.name_and_flavour()}"
      )
    )}</h1>

  {#case Config.get([:ui, :theme, :instance_welcome, :description], "")}
    {#match description when description in [nil, ""]}
    {#match description}
      <div
        id="about-description"
        class="mt-3 prose max-w-none text-[0.9375rem] leading-relaxed text-base-content wrap-anywhere prose-headings:text-base-content prose-h2:text-lg prose-h2:font-semibold prose-a:text-primary *:max-w-2xl *:first:mt-0 *:last:mb-0"
      >{templated_or_remote_markdown(description)}</div>
  {/case}

  <div :if={@is_guest?} id="about-guest-info" class="mt-4 flex flex-col items-start gap-3 text-sm leading-relaxed text-muted">
    <p>{l("You can read public conversations without an account.")}</p>
    {#if Bonfire.Me.Accounts.instance_is_invite_only?()}
      <p data-role="signup-closed-note">{l("New accounts on this community are by invitation only.")}</p>
      <LinkLive
        :if={Config.get([:ui, :theme, :instance_welcome, :invite_contact_email], nil) not in [nil, ""]}
        to={path(:signup)}
        class="btn btn-primary gap-3 text-sm font-bold"
        opts={[id: "about-request-invite"]}
      >
        {l("Request an invite")}
        <#Icon iconify="ph:arrow-right" class="size-4" aria-hidden="true" />
      </LinkLive>
    {/if}
  </div>
</header>
