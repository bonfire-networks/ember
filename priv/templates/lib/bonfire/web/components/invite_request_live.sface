<div class={@wrapper_class}>
  {#case email()}
    {#match email when is_binary(email) and email != ""}
      <a id={@id} href={href(email)} class={"btn btn-primary", @class}>{l("Request an invite")}</a>
    {#match _}
  {/case}
  <StatelessComponent
    module={maybe_component(Bonfire.UI.Me.MessageModeratorsLive, @__context__)}
    class={"btn btn-outline", @class}
  />
</div>
