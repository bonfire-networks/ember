<Bonfire.UI.Common.GuestBoardLive page={:home} bare={true}>
  {!-- profile-style introduction below the banner: who this is, who runs it, where to go; the instance name is the page's one top-level heading --}
  <:hero>
    <Bonfire.Web.Components.HomeHeroLive admins={@admins} />
  </:hero>

  <section :if={@show_spotlight?} id="guest-spotlight">
    {!-- same layout as the Groups widget: the header carries the gutter, the carousel carries it as scroll padding so cards scroll out to the card edge --}
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Reactions.WidgetInstancePinnedCarouselLive, @__context__)}
      id="instance_pinned_widget"
      title={l("Spotlight")}
      wrapper_class="board-card w-full py-5 sm:py-6 [--stream-content-padding:1.25rem] sm:[--stream-content-padding:1.5rem]"
      title_class="gap-3 px-5 pb-4 sm:px-6"
      heading_class="text-lg font-semibold leading-snug tracking-[-0.01em] theme-light:text-lg theme-light:font-semibold"
      button_class="border-transparent bg-transparent text-muted hover:text-base-content"
      carousel_class="px-5 scroll-px-5 sm:px-6 sm:scroll-px-6"
      card_class="rounded-box border-hair border-divider bg-base-100 p-4 [--activity-padding:0] sm:p-5"
      visible_items={1.3}
      visible_items_mobile={1.15}
      hide_empty
    />
  </section>

  {!-- the widget (from bonfire_ui_groups, not a local extension) renders nothing without groups and draws its own top border:
  so the card only applies when it renders, and the border goes (cards are separated by the gap) --}
  <section :if={@show_groups?} id="guest-groups" class="has-[aside]:board-card [&_aside]:border-t-0">
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Groups.WidgetGroupsCarouselLive, @__context__)}
      id="guest_groups_widget"
      title={l("Groups")}
    />
  </section>

  {!-- activities carry the board gutter as their own padding, so no wrapper adds a second one --}
  <section
    class="board-card [--activity-padding:22px_20px] sm:[--activity-padding:22px_24px]"
    aria-labelledby="guest-feed-title"
  >
    {!-- same header rhythm as the Spotlight and Groups widgets above --}
    <div class="border-b border-divider px-5 pb-4 pt-5 sm:px-6 sm:pt-6">
      <h2
        id="guest-feed-title"
        class="text-lg font-semibold leading-snug tracking-[-0.01em] theme-light:text-lg theme-light:font-semibold"
      >{l("Recent activity")}</h2>
    </div>
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.FeedLive, @__context__)}
      :if={@feed_component_id}
      id={@feed_component_id}
      hide_filters
      feed_id={@feed_id}
      feed_name={@feed_name}
      feed_ids={@feed_ids}
      top_page="Explore"
      page_title={@page_title}
      feed={@feed}
      page_info={@page_info}
      loading={@loading}
      time_limit={30}
      current_url="/feed/"
    />
  </section>
</Bonfire.UI.Common.GuestBoardLive>
