<Bonfire.UI.Common.GuestBoardLive page={:home} sheet_id="guest-home" labelledby="about-title">
  <div class="px-4 pb-8 pt-6 sm:px-10 sm:pb-10">
    <Bonfire.Web.Components.AboutIntroLive is_guest?={true}>
      <Bonfire.Web.Components.HomeHeroLive />
    </Bonfire.Web.Components.AboutIntroLive>
    <Bonfire.Web.Components.CommunityGlanceLive
      admins={@admins}
      is_guest?={true}
      class={if Bonfire.UI.Common.GuestBoardLive.community_links() == [], do: "mt-6", else: "mt-2"}
    />
  </div>

  <section :if={@show_spotlight?} id="guest-spotlight" class="has-[aside]:border-t has-[aside]:border-base-content/15">
    {!-- the carousel takes the gutter as scroll padding, so cards scroll out to the sheet's edge --}
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Reactions.PinnedCarouselLive, @__context__)}
      id="instance_pinned_widget"
      title={l("Spotlight")}
      wrapper_class="w-full py-6 sm:py-8"
      title_class="gap-3 px-4 pb-4 sm:px-10"
      heading_class="text-lg font-bold leading-snug tracking-[-0.01em]"
      carousel_class="px-4 scroll-px-4 sm:px-10 sm:scroll-px-10"
      hide_empty
    />
  </section>

  {!-- the widget renders nothing without groups, so the hairline goes on it rather than a wrapper --}
  <section
    :if={@show_groups?}
    id="guest-groups"
    class="has-[aside]:border-t has-[aside]:border-base-content/15 [&_aside]:border-t-0"
  >
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Groups.WidgetGroupsCarouselLive, @__context__)}
      id="guest_groups_widget"
      title={l("Groups")}
      wrapper_class="w-full py-6 sm:py-8"
      title_class="gap-3 px-4 pb-4 sm:px-10"
      carousel_class="px-4 scroll-px-4 sm:px-10 sm:scroll-px-10"
      footer_class="px-4 pt-3 sm:px-10"
    />
  </section>

  <section
    class="border-t border-base-content/15 [--activity-padding:22px_16px] sm:[--activity-padding:22px_40px]"
    aria-labelledby="guest-feed-title"
  >
    <div class="border-b border-base-content/10 px-4 pb-4 pt-6 sm:px-10 sm:pt-8">
      <h2 id="guest-feed-title" class="text-lg font-bold leading-snug tracking-[-0.01em]">{l("Recent activity")}</h2>
    </div>
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.FeedLive, @__context__)}
      :if={@feed_component_id}
      id={@feed_component_id}
      hide_filters
      feed_id={@feed_id}
      feed_name={@feed_name}
      feed_ids={@feed_ids}
      top_page="Explore"
      page_title={@page_title}
      feed={@feed}
      page_info={@page_info}
      loading={@loading}
      time_limit={30}
      current_url="/feed/"
    />
  </section>
</Bonfire.UI.Common.GuestBoardLive>
