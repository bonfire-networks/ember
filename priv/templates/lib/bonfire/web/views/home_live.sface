<Bonfire.UI.Common.GuestBoardLive page={:home} bare={true}>
  {!-- the community introduction below the banner; its tagline is the page's one top-level heading --}
  <:hero>
    <Bonfire.Web.Components.AboutIntroLive is_guest?={true} />
  </:hero>

  <section :if={@show_spotlight?} id="guest-spotlight">
    {!-- The wrapper owns the gutter so both the header and carousel stay inside the board edges. --}
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Reactions.WidgetInstancePinnedCarouselLive, @__context__)}
      id="instance_pinned_widget"
      title={l("Spotlight")}
      subtitle={l("Pinned by the community")}
      wrapper_class="board-card w-full px-5 pb-5.5 pt-4.5 sm:px-6 [--stream-content-padding:1.25rem] sm:[--stream-content-padding:1.5rem]"
      title_class="gap-3 px-0 pb-3.5"
      heading_class="text-xl font-medium leading-snug theme-light:text-2xl theme-light:font-bold"
      subtitle_class="mt-0.5 text-xs text-muted theme-light:text-xs"
      button_class="size-11 border-divider bg-transparent text-primary"
      carousel_class="scroll-px-0"
      card_class="rounded-box bg-surface p-4 [--activity-padding:0] sm:p-5"
      visible_items={1.3}
      visible_items_mobile={1.15}
      hide_empty
    />
  </section>

  {!-- the widget (from bonfire_ui_groups, not a local extension) renders nothing without groups and draws its own top border:
  so the card only applies when it renders, and the border goes (cards are separated by the gap) --}
  <section :if={@show_groups?} id="guest-groups" class="has-[aside]:board-card [&_aside]:border-t-0">
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Groups.WidgetGroupsCarouselLive, @__context__)}
      id="guest_groups_widget"
      title={l("Groups")}
      subtitle={l("Public spaces in this community")}
    />
  </section>

  {!-- activities carry the board gutter as their own padding, so no wrapper adds a second one --}
  <section
    class="board-card [--activity-padding:22px_20px] sm:[--activity-padding:22px_24px]"
    aria-labelledby="guest-feed-title"
  >
    {!-- same header rhythm as the Spotlight and Groups widgets above --}
    <div class="border-b border-divider px-5 pb-3.5 pt-4.5 sm:px-6">
      <h2
        id="guest-feed-title"
        class="text-xl font-medium leading-snug theme-light:text-2xl theme-light:font-bold"
      >{l("Recent activity")}</h2>
      <p class="mt-0.5 text-xs text-muted">{l("Public posts from this community")}</p>
    </div>
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.FeedLive, @__context__)}
      :if={@feed_component_id}
      id={@feed_component_id}
      hide_filters
      feed_id={@feed_id}
      feed_name={@feed_name}
      feed_ids={@feed_ids}
      top_page="Explore"
      page_title={@page_title}
      feed={@feed}
      page_info={@page_info}
      loading={@loading}
      time_limit={30}
      current_url="/feed/"
    />
  </section>
</Bonfire.UI.Common.GuestBoardLive>
