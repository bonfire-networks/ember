<Bonfire.UI.Common.GuestBoardLive page={:home} sheet_id="guest-home" labelledby="about-title">
  {!-- the whole homepage: its widgets (Widgets › Homepage in instance settings), the introduction first by default. They're laid out like the dashboard's (`[data-widget-place]` in interface.css: spacing, dividers, headings, and its gutter, which plain bodies take too) --}
  <section
    :if={@home_widgets != []}
    id="home_main"
    data-widget-place
  >
    <Bonfire.UI.Common.WidgetsLive
      id="home_main_widgets"
      widgets={@home_widgets}
      showing_within={:main}
      reorderable={false}
      use_saved_order={false}
      container_class="flex flex-col"
    />
  </section>

</Bonfire.UI.Common.GuestBoardLive>
