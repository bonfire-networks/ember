{#if @is_guest?}
  <Bonfire.UI.Common.GuestBoardLive page={:about}>
    <Bonfire.Web.Components.AboutContentLive
      is_guest?={@is_guest?}
      selected_tab={@selected_tab}
      has_rules?={@has_rules?}
      rules_sections={@rules_sections}
      admins={@admins}
    />
  </Bonfire.UI.Common.GuestBoardLive>
{#else}
  <div id="member-about" class="min-w-0 bg-base-100 font-(family-name:--font-inter) text-sm leading-relaxed text-base-content">
    <div
      data-role="about-banner"
      class="h-35 bg-fill bg-cover bg-center"
      aria-hidden="true"
      style={Bonfire.UI.Common.NextGenImageLive.background_image_set(Bonfire.UI.Common.GuestBoardLive.banner_image())}
    />
    <Bonfire.Web.Components.AboutContentLive
      is_guest?={@is_guest?}
      selected_tab={@selected_tab}
      has_rules?={@has_rules?}
      rules_sections={@rules_sections}
      admins={@admins}
    />
  </div>
{/if}
