{#if @is_guest?}
  {!-- bare: About lays out its own sheet, which members also get without the board --}
  <Bonfire.UI.Common.GuestBoardLive page={:about} bare={true}>
    <Bonfire.Web.Components.AboutContentLive
      is_guest?={@is_guest?}
      selected_tab={@selected_tab}
      has_rules?={@has_rules?}
      rules_sections={@rules_sections}
      admins={@admins}
      sheet={true}
    />
  </Bonfire.UI.Common.GuestBoardLive>
{#else}
  <div id="member-about" class="min-w-0 bg-base-100 font-(family-name:--font-inter) text-base-content">
    <Bonfire.Web.Components.AboutContentLive
      is_guest?={@is_guest?}
      selected_tab={@selected_tab}
      has_rules?={@has_rules?}
      rules_sections={@rules_sections}
      admins={@admins}
    />
  </div>
{/if}
