{#if @is_guest?}
  <Bonfire.UI.Common.GuestBoardLive page={:privacy}>
    <Bonfire.Web.Components.GuestTextPageLive title={l("Privacy policy")} text={@terms} body_id="privacy-body" />
  </Bonfire.UI.Common.GuestBoardLive>
{#else}
  <div class="w-full bg-base-100">
    <Bonfire.UI.Common.WidgetTextLive text={@terms} />
  </div>
{/if}
